import pandas as pd
import numpy as np
import matplotlib.pyplot as plt
import seaborn as sns
from sklearn.model_selection import train_test_split
from sklearn.preprocessing import StandardScaler, LabelEncoder

# 1. Carga dos Dados
df = pd.read_csv('../data/raw/dataset.csv')
print("--- Primeiras Linhas ---")
display(df.head())

# 2. Inspeção Estrutural (Metadados)
print("\n--- Informações da Base ---")
df.info()

# 3. Pré-processamento: Remoção do ID e Codificação
df_proc = df.drop(columns=['id_cliente'])
le = LabelEncoder()
df_proc['status_emprestimo'] = le.fit_transform(df_proc['status_emprestimo'])

# 4. Divisão Treino e Teste (Stratified Split)
X = df_proc.drop(columns=['status_emprestimo'])
y = df_proc['status_emprestimo']

X_train, X_test, y_train, y_test = train_test_split(
    X, y, test_state=42, test_size=0.20, stratify=y
)

print(f"\nBase de Treino: {X_train.shape[0]} amostras")
print(f"Base de Teste: {X_test.shape[0]} amostras")
